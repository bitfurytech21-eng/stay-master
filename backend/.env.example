# Copy to .env for local development. Never commit real credentials.

PORT=3000

# Where enquiries are stored (SQLite file lives here).
DATA_DIR=./data

# Where enquiries are emailed.
ENQUIRY_TO=easytravelagency@trustagent.space
ENQUIRY_FROM=website@your-domain.com

# SMTP transport. For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-app-password

# Bearer token for GET /api/enquiries (leave empty to disable the endpoint).
ADMIN_TOKEN=

# Comma-separated origins allowed to POST (empty = allow any origin).
ALLOWED_ORIGINS=

# Submissions allowed per IP per 15 minutes.
RATE_LIMIT=5
