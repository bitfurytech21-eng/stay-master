# Copy to .env for local development. Never commit real credentials.

PORT=3000

# Where enquiries are stored (SQLite file lives here).
DATA_DIR=./data

# Where enquiries are emailed.
ENQUIRY_TO=easytravelagency@trustagent.space
ENQUIRY_FROM=website@your-domain.com

# SMTP transport. For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-app-password

# Bearer token for GET /api/enquiries (leave empty to disable the endpoint).
ADMIN_TOKEN=

# Comma-separated origins allowed to POST (empty = allow any origin).
ALLOWED_ORIGINS=

# Submissions allowed per IP per 15 minutes.
RATE_LIMIT=5

# Manual bank transfer checkout (keep disabled until bank details are verified)
MANUAL_BANK_TRANSFER_ENABLED=false
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_CURRENCY=EUR
BANK_SORT_CODE=
BANK_IBAN=
BANK_SWIFT=
BANK_TRANSFER_INSTRUCTIONS=Use your booking reference as the transfer description.

# Google Cloud Translation API key (server-side only; never expose in frontend)
GOOGLE_TRANSLATE_API_KEY=
